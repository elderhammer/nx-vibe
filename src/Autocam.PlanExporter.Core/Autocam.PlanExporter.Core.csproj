<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Autocam.PlanExporter.Core</RootNamespace>
    <AssemblyName>Autocam.PlanExporter.Core</AssemblyName>
    <!-- 与 NX SDK（NXOpen for .NET，.NET Framework 4.8）平台一致 -->
  </PropertyGroup>

  <ItemGroup>
    <!-- 无 VS/.NET Framework targeting pack 的机器也能构建 net48 -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- schema 校验（draft-07），MIT 许可；Newtonsoft.Json.Schema 为商业许可，避免引入 -->
    <PackageReference Include="NJsonSchema" Version="11.1.0" />
  </ItemGroup>

</Project>
